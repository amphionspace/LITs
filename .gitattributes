# Store model weights with Git LFS.
*.ckpt filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text

# CSV evidence uses the standard CRLF dialect; preserve snapshot bytes.
docs/majestic_training_record_assets/*.csv -text whitespace=cr-at-eol
